<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ejecutable de pruebas de la API V3.
    No referencia a la API ni a sus DLL: la prueba por HTTP, igual que un cliente real.
    Uso: ver README.md de esta carpeta.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>API_GESI_V3.Pruebas</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Update="configuracion.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="pruebas.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Bodies\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
